# regenerated; ignore the heavy data outputs (.npz/.png/.md etc.) they produce.
Results/**
!Results/**/
!Results/**/*.jl
!Results/**/*.py
scratch/

# --- Local backups ---
*.bak
requirements_old-stack_*.txt
pyproject_pre-langgraph_*.toml

# --- Confidential peer-review materials ---
Reviews/

# --- Notebooks kept locally, not tracked ---
*.ipynb
# ...except the paper-figure notebooks (outputs stripped, repo-relative paths)
!Plots/*.ipynb

