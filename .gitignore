# --- Secrets ---
.env
**/.env
*.env
!.env_template
!**/.env_template

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- Local agents.py backups from the langgraph migration ---
crunch_llm/code/agents_*.py

# --- LaTeX build cruft ---
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz

# --- Generated run outputs ---
# Track the generated per-figure scripts (.jl/.py); ignore the heavy data
# outputs (.npz/.png/.md) by default. The specific data files the Plots/
# notebooks read are curated (long time series sliced to the displayed frames)
# and force-added (git add -f) despite this rule, so the figures reproduce from
# a clone — see Plots/README.md.
Results/**
!Results/**/
!Results/**/*.jl
!Results/**/*.py
# Exploratory candidate runs copied in locally so Similarity_Analysis/Similarity.ipynb
# runs top-to-bottom; kept out of the commit (repo stays the curated subset).
Results/NM_codes/Burgers_Periodic_SinHalfSum/2025_12_11_2154/
Results/NM_codes/Burgers_Periodic_SinHalfSum/2025_12_15_2212/
Results/NM_codes/Burgers_Periodic_SinHalfSum/2025_12_15_2228/
Results/NM_codes/Burgers_Periodic_SinSum/2025_12_11_2256/

# Dispatcher run transcripts. Normal runs now log to Examples_<family>/<name>_log.txt;
# this dir only fills when an explicit log_base= override is passed. Scratch — not tracked.
crunch_llm/code/HENA_logs/
scratch/

# --- Local backups ---
*.bak
requirements_old-stack_*.txt
pyproject_pre-langgraph_*.toml

# --- Confidential peer-review materials ---
Reviews/

# --- Notebooks kept locally, not tracked ---
*.ipynb
# ...except the paper-figure notebooks (outputs stripped, repo-relative paths)
!Plots/*.ipynb
# ...and the code-similarity analysis notebook (same convention: outputs stripped,
# repo-relative paths) — part of the reproducibility artifacts.
!Similarity_Analysis/Similarity.ipynb

# --- Large reference dataset (download from Google Drive, see README) ---
Documents/codes/Data/Burger_1000_5000.mat
